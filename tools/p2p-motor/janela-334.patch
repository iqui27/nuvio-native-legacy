+// Streaming window (#334). Bytes kept on disk while a file plays are:
+// protected head + protected tail + what stays behind the playhead + the
+// read-ahead in front of it. The window trims at high_water and stops at
+// low_water, so the read-ahead must fit under low_water with the rest.
+constexpr std::uint64_t window_head_bytes = 8 * 1024 * 1024;
+constexpr std::uint64_t window_tail_bytes = 16 * 1024 * 1024;
+constexpr std::uint64_t window_minimum_behind_bytes = 16 * 1024 * 1024;
+constexpr std::uint64_t window_maximum_behind_bytes = 64 * 1024 * 1024;
+constexpr std::uint64_t window_minimum_readahead_bytes = 48 * 1024 * 1024;
+constexpr std::chrono::milliseconds window_check_interval{100};
+
+std::uint64_t window_low_water(const std::uint64_t window_bytes) {
+    return window_bytes / 4 * 3;
+}
+
+std::uint64_t window_high_water(const std::uint64_t window_bytes) {
+    return window_bytes / 20 * 17;
+}
+
+std::uint64_t window_behind_bytes(const std::uint64_t window_bytes) {
+    return std::clamp(
+        window_bytes / 8,
+        window_minimum_behind_bytes,
+        window_maximum_behind_bytes
+    );
+}
+
+// playback + read-ahead (what readahead_for returns); the critical bytes in
+// front of the playhead come on top of it
+std::uint64_t window_readahead_bytes(const std::uint64_t window_bytes) {
+    const auto fixed = window_head_bytes + window_tail_bytes +
+        window_behind_bytes(window_bytes) + critical_window_bytes;
+    const auto low = window_low_water(window_bytes);
+    const auto available = low > fixed ? low - fixed : 0;
+    return std::clamp(
+        available / 4 * 3,
+        window_minimum_readahead_bytes,
+        maximum_readahead_bytes
+    );
+}
+
+std::uint64_t readahead_for(
+    const std::uint64_t disk_capacity_bytes,
+    const std::uint64_t window_bytes
+) {
+    if (window_bytes > 0) {
+        return std::min(
+            readahead_for_disk_budget(disk_capacity_bytes),
+            window_readahead_bytes(window_bytes)
+        );
+    }
+    return readahead_for_disk_budget(disk_capacity_bytes);
+}
