+ * ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ * OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+/*
+ * ARMv7 NEON rasterizer, included twice from neon32.c (TILE_SIZE 16 and 32).
+ * Every operation mirrors c/rasterizer_template.h with the same int16
+ * truncation, so the output is bit-identical to the C engine.
+ */
+
+#if   TILE_SIZE == 16
+#define N32S(name)  name ## 16_neon32
+#define TILE_ORDER  4
+#elif TILE_SIZE == 32
+#define N32S(name)  name ## 32_neon32
+#define TILE_ORDER  5
+#else
+#error Unsupported tile size
+#endif
+
+#define NV            (TILE_SIZE / 8)
+#define FULL_VALUE    (1 << (14 - TILE_ORDER))
+#define RESCALE_AB(ab, scale) \
+    (((ab) * (int64_t) (scale) + ((int64_t) 1 << (45 + TILE_ORDER))) >> (46 + TILE_ORDER))
+#define RESCALE_C(c, scale) \
+    (((int32_t) ((c) >> (7 + TILE_ORDER)) * (int64_t) (scale) + ((int64_t) 1 << 44)) >> 45)
+
+
+static void N32S(ass_fill_solid_tile)(uint8_t *buf, ptrdiff_t stride, int set)
+{
+    uint8x16_t v = vdupq_n_u8(set ? 255 : 0);
+    for (int y = 0; y < TILE_SIZE; y++) {
+        for (int j = 0; j < TILE_SIZE / 16; j++)
+            vst1q_u8(buf + 16 * j, v);
+        buf += stride;
+    }
+}
+
+
+static void N32S(ass_fill_halfplane_tile)(uint8_t *buf, ptrdiff_t stride,
+                                          int32_t a, int32_t b, int64_t c, int32_t scale)
+{
+    int16_t aa = RESCALE_AB(a, scale), bb = RESCALE_AB(b, scale);
+    int16_t cc = RESCALE_C(c, scale) + FULL_VALUE / 2 - ((aa + bb) >> 1);
+
+    int16_t abs_a = aa < 0 ? -aa : aa;
+    int16_t abs_b = bb < 0 ? -bb : bb;
+    int16_t delta = (FFMIN(abs_a, abs_b) + 2) >> 2;
+
+    // va1[x] = aa * x - delta, va2[x] = aa * x + delta (int16 wrap, as in C)
+    int16x8_t va1[NV], va2[NV];
+    const int16x8_t vdelta = vdupq_n_s16(delta);
+    for (int j = 0; j < NV; j++) {
+        int16x8_t x = vaddq_s16(nv32_index16(), vdupq_n_s16(8 * j));
+        int16x8_t ax = vmulq_n_s16(x, aa);
+        va1[j] = vsubq_s16(ax, vdelta);
+        va2[j] = vaddq_s16(ax, vdelta);
+    }
+
+    const int16x8_t zero = vdupq_n_s16(0), full = vdupq_n_s16(FULL_VALUE);
+    for (int y = 0; y < TILE_SIZE; y++) {
+        int16x8_t vc = vdupq_n_s16(cc);
+        for (int j = 0; j < NV; j += 2) {
+            int16x8_t c1 = vsubq_s16(vc, va1[j]);
+            int16x8_t c2 = vsubq_s16(vc, va2[j]);
+            c1 = vminq_s16(vmaxq_s16(c1, zero), full);
+            c2 = vminq_s16(vmaxq_s16(c2, zero), full);
+            int16x8_t r0 = vshrq_n_s16(vaddq_s16(c1, c2), 7 - TILE_ORDER);
+            c1 = vsubq_s16(vc, va1[j + 1]);
+            c2 = vsubq_s16(vc, va2[j + 1]);
+            c1 = vminq_s16(vmaxq_s16(c1, zero), full);
+            c2 = vminq_s16(vmaxq_s16(c2, zero), full);
+            int16x8_t r1 = vshrq_n_s16(vaddq_s16(c1, c2), 7 - TILE_ORDER);
+            vst1q_u8(buf + 8 * j, vcombine_u8(vqmovun_s16(r0), vqmovun_s16(r1)));
+        }
+        buf += stride;
+        cc -= bb;
+    }
+}
+
+
+// Render top/bottom line of the trapezoid with antialiasing (same as C)
+static inline void N32S(update_border_line)(int16x8_t res[NV],
+                                            int16_t abs_a, const int16x8_t va[NV],
+                                            int16_t b, int16_t abs_b,
+                                            int16_t c, int up, int dn)
+{
+    int16_t size = dn - up;
+    int16_t w = FULL_VALUE + (size << (8 - TILE_ORDER)) - abs_a;
+    w = FFMIN(w, FULL_VALUE) << (2 * TILE_ORDER - 5);
+
+    int16_t dc_b = abs_b * (int32_t) size >> 6;
+    int16_t dc = (FFMIN(abs_a, dc_b) + 2) >> 2;
+
+    int16_t base = (int32_t) b * (int16_t) (up + dn) >> 7;
+    int16_t offs1 = size - ((base + dc) * (int32_t) w >> 16);
+    int16_t offs2 = size - ((base - dc) * (int32_t) w >> 16);
+
+    size <<= 1;
+    const int16x8_t vo1 = vdupq_n_s16(offs1), vo2 = vdupq_n_s16(offs2);
+    const int16x8_t zero = vdupq_n_s16(0), vsize = vdupq_n_s16(size);
+    const int16x4_t vcc = vdup_n_s16(c);
+    for (int j = 0; j < NV; j++) {
+        // cw = (c - va[x]) * w >> 16, with c - va[x] in 32 bits as in C
+        int32x4_t lo = vmulq_n_s32(vsubl_s16(vcc, vget_low_s16(va[j])), w);
+        int32x4_t hi = vmulq_n_s32(vsubl_s16(vcc, vget_high_s16(va[j])), w);
+        int16x8_t cw = vcombine_s16(vmovn_s32(vshrq_n_s32(lo, 16)),
+                                    vmovn_s32(vshrq_n_s32(hi, 16)));
+        int16x8_t c1 = vaddq_s16(cw, vo1);
+        int16x8_t c2 = vaddq_s16(cw, vo2);
+        c1 = vminq_s16(vmaxq_s16(c1, zero), vsize);
+        c2 = vminq_s16(vmaxq_s16(c2, zero), vsize);
+        res[j] = vaddq_s16(res[j], vaddq_s16(c1, c2));
+    }
+}
+
+static void N32S(ass_fill_generic_tile)(uint8_t *restrict buf, ptrdiff_t stride,
+                                        const struct segment *restrict line, size_t n_lines,
+                                        int winding)
+{
+    int16x8_t res[TILE_SIZE][NV];
+    for (int y = 0; y < TILE_SIZE; y++)
+        for (int j = 0; j < NV; j++)
+            res[y][j] = vdupq_n_s16(0);
+    int16_t delta[TILE_SIZE + 2] = {0};
+
+    const int16x8_t zero = vdupq_n_s16(0), full = vdupq_n_s16(FULL_VALUE);
+    const struct segment *end = line + n_lines;
+    for (; line != end; ++line) {
+        int16_t up_delta = line->flags & SEGFLAG_DN ? 4 : 0;
+        int16_t dn_delta = up_delta;
+        if (!line->x_min && (line->flags & SEGFLAG_EXACT_LEFT)) dn_delta ^= 4;
+        if (line->flags & SEGFLAG_UL_DR) {
+            int16_t tmp = up_delta;
+            up_delta = dn_delta;
+            dn_delta = tmp;
+        }
+
+        int up = line->y_min >> 6, dn = line->y_max >> 6;
+        int16_t up_pos = line->y_min & 63;
+        int16_t up_delta1 = up_delta * up_pos;
+        int16_t dn_pos = line->y_max & 63;
+        int16_t dn_delta1 = dn_delta * dn_pos;
+        delta[up + 1] -= up_delta1;
+        delta[up] -= (up_delta << 6) - up_delta1;
+        delta[dn + 1] += dn_delta1;
+        delta[dn] += (dn_delta << 6) - dn_delta1;
+        if (line->y_min == line->y_max)
+            continue;
+
+        int16_t a = RESCALE_AB(line->a, line->scale);
+        int16_t b = RESCALE_AB(line->b, line->scale);
+        int16_t c = RESCALE_C(line->c, line->scale) - (a >> 1) - b * up;
+
+        int16x8_t va[NV];
+        for (int j = 0; j < NV; j++)
+            va[j] = vmulq_n_s16(vaddq_s16(nv32_index16(), vdupq_n_s16(8 * j)), a);
+        int16_t abs_a = a < 0 ? -a : a;
+        int16_t abs_b = b < 0 ? -b : b;
+        int16_t dc = (FFMIN(abs_a, abs_b) + 2) >> 2;
+        int16_t base = FULL_VALUE / 2 - (b >> 1);
+        int16_t dc1 = base + dc;
+        int16_t dc2 = base - dc;
+
+        if (up_pos) {
+            if (dn == up) {
+                N32S(update_border_line)(res[up], abs_a, va, b, abs_b, c, up_pos, dn_pos);
+                continue;
+            }
+            N32S(update_border_line)(res[up], abs_a, va, b, abs_b, c, up_pos, 64);
+            up++;
+            c -= b;
+        }
+        // c1 = c - va[x] + dc1, c2 = c - va[x] + dc2 (int16 wrap, as in C)
+        int16x8_t vb1[NV], vb2[NV];
+        for (int j = 0; j < NV; j++) {
+            vb1[j] = vsubq_s16(vdupq_n_s16(dc1), va[j]);
+            vb2[j] = vsubq_s16(vdupq_n_s16(dc2), va[j]);
+        }
+        for (int y = up; y < dn; y++) {
+            int16x8_t vc = vdupq_n_s16(c);
+            for (int j = 0; j < NV; j++) {
+                int16x8_t c1 = vaddq_s16(vc, vb1[j]);
+                int16x8_t c2 = vaddq_s16(vc, vb2[j]);
+                c1 = vminq_s16(vmaxq_s16(c1, zero), full);
+                c2 = vminq_s16(vmaxq_s16(c2, zero), full);
+                res[y][j] = vsraq_n_s16(res[y][j], vaddq_s16(c1, c2), 7 - TILE_ORDER);
+            }
+            c -= b;
+        }
+        if (dn_pos)
+            N32S(update_border_line)(res[dn], abs_a, va, b, abs_b, c, 0, dn_pos);
+    }
+
+    int16_t cur = 256 * (int8_t) winding;
+    for (int y = 0; y < TILE_SIZE; y++) {
+        cur += delta[y];
+        int16x8_t vcur = vdupq_n_s16(cur);
+        for (int j = 0; j < NV; j += 2) {
+            // |res + cur| (int16 wrap) clamped to 0..255; |-32768| stays
+            // negative and saturates to 0, exactly like the C code
+            int16x8_t v0 = vabsq_s16(vaddq_s16(res[y][j], vcur));
+            int16x8_t v1 = vabsq_s16(vaddq_s16(res[y][j + 1], vcur));
+            vst1q_u8(buf + 8 * j, vcombine_u8(vqmovun_s16(v0), vqmovun_s16(v1)));
+        }
+        buf += stride;
+    }
+}
+
+
+static void N32S(ass_merge_tile)(uint8_t *restrict buf, ptrdiff_t stride,
+                                 const uint8_t *restrict tile)
+{
+    for (int y = 0; y < TILE_SIZE; y++) {
+        for (int j = 0; j < TILE_SIZE / 16; j++)
+            vst1q_u8(buf + 16 * j, vmaxq_u8(vld1q_u8(buf + 16 * j), vld1q_u8(tile + 16 * j)));
+        buf += stride;
+        tile += TILE_SIZE;
+    }
+}
+
+
+#undef N32S
+#undef TILE_ORDER
+#undef NV
+#undef FULL_VALUE
+#undef RESCALE_AB
+#undef RESCALE_C
