+/* ---- small worker pool --------------------------------------------------- */
+
+#include <pthread.h>
+
+#define NV32_MAX_THREADS 4
+
+typedef void Nv32Part(const void *job, size_t from, size_t to);
+
+static struct {
+    pthread_mutex_t lock, call;     // call: one dispatcher at a time
+    pthread_cond_t go, done;
+    int started, wanted;            // helper threads alive / wanted in total (incl. caller)
+    unsigned gen;
+    int pending;
+    Nv32Part *fn;
+    const void *job;
+    size_t n, parts;
+} nv32_pool = {
+    PTHREAD_MUTEX_INITIALIZER, PTHREAD_MUTEX_INITIALIZER,
+    PTHREAD_COND_INITIALIZER, PTHREAD_COND_INITIALIZER,
+    0, 1, 0, 0, NULL, NULL, 0, 0
+};
+
+static void nv32_run_part(Nv32Part *fn, const void *job, size_t n, size_t parts, size_t k)
 {
-    for (size_t y = 0; y < height; y++) {
+    size_t from = n * k / parts, to = n * (k + 1) / parts;
+    if (to > from)
+        fn(job, from, to);
+}
+
+static void *nv32_helper(void *arg)
+{
+    size_t k = (size_t) (uintptr_t) arg;   // part index 1..
+    unsigned seen = 0;
+    pthread_mutex_lock(&nv32_pool.lock);
+    for (;;) {
+        while (nv32_pool.gen == seen)
+            pthread_cond_wait(&nv32_pool.go, &nv32_pool.lock);
+        seen = nv32_pool.gen;
+        Nv32Part *fn = nv32_pool.fn;
+        const void *job = nv32_pool.job;
+        size_t n = nv32_pool.n, parts = nv32_pool.parts;
+        int mine = k < parts;
+        pthread_mutex_unlock(&nv32_pool.lock);
+        if (mine)
+            nv32_run_part(fn, job, n, parts, k);
+        pthread_mutex_lock(&nv32_pool.lock);
+        if (mine && --nv32_pool.pending == 0)
+            pthread_cond_signal(&nv32_pool.done);
+    }
+    return NULL;
+}
+
+int ass_nv32_set_threads(int n)
+{
+    if (n < 1) n = 1;
+    if (n > NV32_MAX_THREADS) n = NV32_MAX_THREADS;
+    pthread_mutex_lock(&nv32_pool.call);
+    pthread_mutex_lock(&nv32_pool.lock);
+    while (nv32_pool.started + 1 < n) {
+        pthread_t t;
+        pthread_attr_t at;
+        pthread_attr_init(&at);
+        pthread_attr_setdetachstate(&at, PTHREAD_CREATE_DETACHED);
+        int ok = pthread_create(&t, &at, nv32_helper,
+                                (void *) (uintptr_t) (nv32_pool.started + 1)) == 0;
+        pthread_attr_destroy(&at);
+        if (!ok)
+            break;
+        nv32_pool.started++;
+    }
+    if (n > nv32_pool.started + 1)
+        n = nv32_pool.started + 1;
+    nv32_pool.wanted = n;
+    pthread_mutex_unlock(&nv32_pool.lock);
+    pthread_mutex_unlock(&nv32_pool.call);
+    return n;
+}
+
+int ass_nv32_get_threads(void)
+{
+    return __atomic_load_n(&nv32_pool.wanted, __ATOMIC_RELAXED);
+}
+
+static size_t nv32_par_min = 65536;
+
+/* Runs fn over [0, n) split in parts. `work` is the number of int16 lanes
+ * touched; small jobs stay on the calling thread (waking helpers costs more). */
+static void nv32_par(Nv32Part *fn, const void *job, size_t n, size_t work)
+{
+    int threads = __atomic_load_n(&nv32_pool.wanted, __ATOMIC_RELAXED);
+    size_t parts = (size_t) threads;
+    if (parts > n)
+        parts = n;
+    if (parts <= 1 || work < nv32_par_min || pthread_mutex_trylock(&nv32_pool.call)) {
+        fn(job, 0, n);
+        return;
+    }
+    pthread_mutex_lock(&nv32_pool.lock);
+    nv32_pool.fn = fn;
+    nv32_pool.job = job;
+    nv32_pool.n = n;
+    nv32_pool.parts = parts;
+    nv32_pool.pending = (int) parts - 1;
+    nv32_pool.gen++;
+    pthread_cond_broadcast(&nv32_pool.go);
+    pthread_mutex_unlock(&nv32_pool.lock);
+
+    nv32_run_part(fn, job, n, parts, 0);
+
+    pthread_mutex_lock(&nv32_pool.lock);
+    while (nv32_pool.pending > 0)
+        pthread_cond_wait(&nv32_pool.done, &nv32_pool.lock);
+    pthread_mutex_unlock(&nv32_pool.lock);
+    pthread_mutex_unlock(&nv32_pool.call);
+}
